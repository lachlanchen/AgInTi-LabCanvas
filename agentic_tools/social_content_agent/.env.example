# Postiz supports OAuth login without placing a key here. Set these only when
# using an API key or self-hosted instance.
POSTIZ_API_URL=https://api.postiz.com
POSTIZ_API_KEY=

# Optional official X MCP. A Developer Platform app is required.
X_OAUTH_CONSUMER_KEY=
X_OAUTH_CONSUMER_SECRET=
X_BEARER_TOKEN=
X_API_TOOL_ALLOWLIST=getUsersMe,getUsersPosts,getPostsAnalytics,searchPostsRecent,createPosts
MCP_HOST=127.0.0.1
MCP_PORT=18892
