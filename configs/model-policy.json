{
  "primary_backend": "codex",
  "codex": {
    "account_pool": "agentshell",
    "primary_model": "gpt-6-astra",
    "allow_paid_credits": false,
    "reserve_enabled": true,
    "reserve_model": "gpt-5.6-luna",
    "fallback_backend": "aginti",
    "session_policy": "resume one shared-history session per conversation and role"
  },
  "aginti": {
    "primary_provider": "deepseek",
    "provider_chain": [
      "deepseek",
      "localllm"
    ],
    "provider_models": {
      "deepseek": "deepseek-v4-flash",
      "localllm": "localllm-fast"
    },
    "provider_models_by_effort": {
      "localllm": {
        "low": "localllm-fast",
        "medium": "localllm-deep",
        "high": "localllm-deep",
        "xhigh": "localllm-deep"
      }
    },
    "session_policy": "resume one durable session per conversation and role"
  },
  "chat": {
    "model": "gpt-6-astra",
    "reasoning_effort": "low"
  },
  "task": {
    "model": "gpt-6-astra",
    "reasoning_effort": "medium"
  },
  "high": {
    "model": "gpt-6-astra",
    "reasoning_effort": "high"
  },
  "xhigh": {
    "model": "gpt-6-astra",
    "reasoning_effort": "xhigh"
  },
  "memory": {
    "context_window_tokens": {
      "default": 32768,
      "localllm": 32768,
      "localllm-fast": 32768,
      "localllm-deep": 32768,
      "deepseek": 65536,
      "deepseek-v4-flash": 65536,
      "codex": 114688,
      "auto-code-review": 114688,
      "gpt-5.6-sol": 114688
    },
    "output_reserve_tokens": 6144,
    "tool_reserve_tokens": 6144,
    "minimum_memory_tokens": 2048,
    "maximum_memory_tokens": 24576,
    "role_memory_fraction": {
      "chat": 0.24,
      "task": 0.34,
      "research": 0.4,
      "daily": 0.42,
      "default": 0.34
    },
    "full_memory_fraction": 0.72
  },
  "fallback": {
    "chat": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "low"
    },
    "task": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "medium"
    },
    "high": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high"
    },
    "xhigh": {
      "model": "gpt-5.6-sol",
      "reasoning_effort": "xhigh"
    }
  },
  "aginti_learning": {
    "enabled": true,
    "mode": "shadow_review",
    "source_backend": "codex",
    "execute_tools": false,
    "send_output": false,
    "safe_task_only": true
  },
  "notes": "GPT-6 Astra is the default. Paid Codex credits are prohibited for all LabCanvas chat and scheduled work. AgentShell selects only accounts with fresh verified subscription quota, then GPT-5.6 Luna with an explicitly observed reserve allowance. Unknown/exhausted accounts are not paid-credit fallbacks. Reserve is separate from regular quota; never infer reserve access from a low percentage. GPT-5.6 SOL remains the model-unavailable compatibility fallback. AgInTi follows Codex availability. Preserve per-conversation shared history and do not replay after side-effecting tool activity."
}
